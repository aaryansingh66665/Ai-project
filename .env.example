# CyberAgent X — Environment Configuration
# Copy this file to .env and edit values as needed.
# All values below are the production defaults.

# ─── OLLAMA ──────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=120

# ─── NVIDIA GPU ──────────────────────────────────────────
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0
OLLAMA_NUM_GPU=99
NVIDIA_VISIBLE_DEVICES=all

# ─── WEB SERVER ──────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# ─── AGENT MODELS (override per-agent if needed) ─────────
MODEL_ORCHESTRATOR=qwen3:8b
MODEL_OSINT=qwen3:4b
MODEL_THREAT_INTEL=deepseek-r1:8b
MODEL_CODER=qwen2.5-coder:7b
MODEL_MALWARE=qwen3:8b
MODEL_NETWORK=gemma3:4b
MODEL_SWARM=gemma3:4b
MODEL_REPORT=gemma3:4b
MODEL_REDTEAM=phi4-mini:3.8b
MODEL_NEMOTRON=nemotron-mini:4b

# ─── FEATURE FLAGS ───────────────────────────────────────
AUTO_UNLOAD_MODELS=true
LOG_LEVEL=WARNING
